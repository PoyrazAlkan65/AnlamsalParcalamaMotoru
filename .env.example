# Anlamsal Parçalama Motoru — Ortam Değişkenleri — örnek (.env olarak kopyalayın, gizli değerleri doldurun)
# Tüm ayarlar buradan okunur; kodda varsayılan değer yoktur. Anahtarları silmeyin.

# ---- Embedding ----
EMBEDDING_MODEL=BAAI/bge-m3
# modelin vektör boyutu (bge-m3: 1024)
EMBEDDING_DIM=1024
EMBEDDING_BATCH=16

# ---- Whisper ----
# turbo · large-v3 · medium
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=tr
# kısa adların gerçek model kimlikleri
WHISPER_MODEL_TURBO=turbo
WHISPER_MODEL_LARGE_V3=large-v3
WHISPER_MODEL_MEDIUM=medium
WHISPER_BENCHMARK=false

# ---- Image captioning ----
CAPTION_MODEL=Salesforce/blip-image-captioning-large
OCR_LANGS=tur+eng

# ---- Chunking ----
CHUNK_SIM_THRESHOLD=0.5
CHUNK_MIN_TOKENS=64
CHUNK_MAX_TOKENS=512

# ---- Tesseract ----
# Windows'ta tesseract.exe yolu; boşsa PATH'teki kullanılır
TESSERACT_CMD=

# ---- Web ----
WEB_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
PLAYWRIGHT_TIMEOUT_MS=30000

# ---- YouTube (yt-dlp) ----
# sırayla denenir: deno, node (>=22), bun, quickjs
YTDLP_JS_RUNTIMES=deno,node

# ---- Qdrant ----
QDRANT_ENABLED=true
QDRANT_HOST=
QDRANT_PORT=6333
# boş bırakılabilir
QDRANT_API_KEY=
QDRANT_COLLECTION=

# ---- Kaynak veritabanı (MSSQL) ----
MSSQL_SERVER=
MSSQL_DBNAME=
MSSQL_USER=
MSSQL_PWD=
MSSQL_POOL_MAX=10
MSSQL_POOL_MIN=0
# ms
MSSQL_POOL_TIMEOUT=30000
MSSQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server
# boş: sürücü varsayılanı · yes / no
MSSQL_ENCRYPT=
MSSQL_TRUST_SERVER_CERTIFICATE=yes
# MSSQL dışı veritabanı için SQLAlchemy URL'i; doluysa MSSQL_* yerine kullanılır
SOURCE_DB_URL=
# source_uri'de görünen ad; boşsa veritabanı adı
SOURCE_DB_LABEL=

# ---- Duygu analizi (NoemaVibeAPI nlp-service) ----
EMOTION_ENABLED=true
# nlp-service yalnızca 127.0.0.1'i dinler; uygulama NoemaVibeAPI ile aynı sunucuda çalışmalı
EMOTION_API_URL=http://127.0.0.1:31531
EMOTION_API_TIMEOUT=30
EMOTION_API_CONCURRENCY=8
