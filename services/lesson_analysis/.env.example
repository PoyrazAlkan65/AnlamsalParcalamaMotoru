# Ders analizi servisi — services/lesson_analysis/.env olarak kopyalayın

# ---- LMS veritabanı ----
LA_MSSQL_SERVER=
LA_MSSQL_DB=SedaUlgenTest
LA_MSSQL_USER=
LA_MSSQL_PWD=
LA_MSSQL_ENCRYPT=0
# LA_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# ---- Yapay zekâ ----
# LLMModel.Id (Admin GROWTH_LLM_MODEL_ID ile aynı)
LA_LLM_MODEL_ID=19
# LA_LLM_TIMEOUT_SEC=300

# ---- Analiz ----
# Ders dağılımında bu oranın altındaki köşeler atılır
LA_MIN_RATIO=0.05
# LA_MAX_CHUNK_GROUPS=3
# 1: analiz doğrudan geçerli; 0: admin onayı bekler
LA_AUTO_APPROVE=1

# ---- Parçalama ----
# semantic: bge-m3 ile anlamsal (önerilen) · lines: satır gruplama (hızlı deneme)
LA_CHUNKER=semantic
# LA_CHUNKER_MAX_CHARS=1600
# Bu token sayısının altındaki parçalar komşusuyla birleşir
# LA_CHUNK_MIN_TOKENS=60

# ---- Worker ----
# LA_WORKER_ID=sunucu-1
# LA_POLL_SECONDS=15
# LA_STALE_MINUTES=30
# LA_HEARTBEAT_SECONDS=60

# ---- API ----
LA_API_KEY=
