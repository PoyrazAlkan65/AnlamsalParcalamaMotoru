# Ders analizi servisi — örnek (.env olarak kopyalayın, gizli değerleri doldurun)
# Tüm ayarlar buradan okunur; kodda varsayılan değer yoktur. Anahtarları silmeyin.

# ---- LMS veritabanı ----
LA_MSSQL_SERVER=
LA_MSSQL_DB=
LA_MSSQL_USER=
LA_MSSQL_PWD=
LA_MSSQL_ENCRYPT=0
LA_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# ---- Yapay zekâ ----
# LLMModel.Id (Admin GROWTH_LLM_MODEL_ID ile aynı)
LA_LLM_MODEL_ID=19
LA_LLM_TIMEOUT_SEC=300

# ---- Analiz ----
# ders dağılımında bu oranın altındaki köşeler atılır
LA_MIN_RATIO=0.05
LA_MAX_CHUNK_GROUPS=3
# 1: analiz doğrudan geçerli · 0: admin onayı bekler
LA_AUTO_APPROVE=1

# ---- Parçalama ----
# semantic: bge-m3 ile anlamsal · lines: satır gruplama (hızlı deneme)
LA_CHUNKER=semantic
LA_CHUNKER_MAX_CHARS=1600
# bu token sayısının altındaki parçalar komşusuyla birleşir
LA_CHUNK_MIN_TOKENS=60

# ---- Worker ----
# boşsa makine adı:süreç no
LA_WORKER_ID=
LA_POLL_SECONDS=15
LA_STALE_MINUTES=30
LA_HEARTBEAT_SECONDS=60

# ---- API ----
# boşsa API istekleri 503 döner
LA_API_KEY=
